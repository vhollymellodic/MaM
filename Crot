local function scanCrystals()
    currentCrystalCount = 0
    local valueList, weightList = {}, {}
    
    local maxCap, currCap = getCapacityInfo()
    local remCap = maxCap - currCap
    if maxCap <= 0 then remCap = math.huge end 
    
    for inst, data in pairs(crystalCache) do
        if inst and inst.Parent then
            -- MENCEGAH RUNE MASUK KE DAFTAR TELEPORT FARM / UI
            if not data.IsRune then 
                currentCrystalCount = currentCrystalCount + 1
                if data.Weight <= remCap and data.Weight <= maxCap then
                    table.insert(valueList, data)
                    table.insert(weightList, data)
                end
            end
        else
            crystalCache[inst] = nil
        end
    end
    
    table.sort(valueList, function(a, b) return a.Value > b.Value end)
    table.sort(weightList, function(a, b) return a.Weight > b.Weight end)
    
    currentMaxCrystalValue = (#valueList > 0) and valueList[1].Value or 0
    
    return valueList, weightList
end

local function getNextCrystalTarget()
    local vList, wList = scanCrystals()
    local listToUse = (currentCrystalMode <= 2) and vList or wList
    if #listToUse == 0 then return nil end
    local startIdx = (currentCrystalMode % 2 == 1) and 1 or #listToUse
    local endIdx = (currentCrystalMode % 2 == 1) and #listToUse or 1
    local iterStep = (currentCrystalMode % 2 == 1) and 1 or -1
    
    for i = startIdx, endIdx, iterStep do
        local instData = listToUse[i]
        local inst = instData.Instance
        
        if inst and not failedCrystals[inst] then
            local shouldSkip = false
            if currentCrystalMode <= 2 then
                if instData.Value < minCrystalValueThreshold then
                    shouldSkip = true
                end
            end
            if not shouldSkip then
                return inst
            end
        end
    end
    return nil
end

local function getNextAutoFarmTarget()
    local bouldersFolder = getBouldersFolder()
    if not bouldersFolder then return nil end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    for _, pName in ipairs(autoFarmPriorityOrder) do
        if boulderToggles[pName] then
            local closest = nil
            local minDist = math.huge
            for _, b in ipairs(bouldersFolder:GetChildren()) do
                if string.find(string.lower(b.Name), string.lower(pName)) then
                    local part = getTargetPart(b)
                    if part then
                        local hp = getTargetHP(b)
                        if hp == nil or hp > 0 then
                            local dist = (root.Position - part.Position).Magnitude
                            if dist < minDist then
                                minDist = dist
                                closest = part
                            end
                        end
                    end
                end
            end
            if closest then return closest end
        end
    end
    return nil
end

