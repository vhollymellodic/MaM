        if AutoFarmBtn then
            AutoFarmBtn.Text = "Auto Farm Sequence: OFF"
            AutoFarmBtn.TextColor3 = THEME.AccentOrange
        end
        for _, toggleBtn in pairs(boulderToggleBtns) do
            if toggleBtn and toggleBtn.Parent then toggleBtn.Parent.Visible = true end
        end
        stopAutoMine(false)
        task.wait(0.1)
    end
    
    isCrystalFarming = not isCrystalFarming
