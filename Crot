for name, tpBtn in pairs(boulderTPButtons) do
    tpBtn.MouseButton1Click:Connect(function()
        if not tpBtn.Active then return end
        if isAutoFarming then
            if not isAutoFarmBlinking then
                isAutoFarmBlinking = true
                task.spawn(function()
                    for i = 1, 5 do
                        if AutoFarmBtn then AutoFarmBtn.BackgroundColor3 = THEME.AccentRed end
                        task.wait(0.1)
                        if AutoFarmBtn then AutoFarmBtn.BackgroundColor3 = THEME.CardBg end
                        task.wait(0.1)
                    end
                    isAutoFarmBlinking = false
                end)
            end
            return
        end
        if activeTPBtn == tpBtn then stopAutoMine(false); pcall(updateUI); return end

        local bouldersFolder = getBouldersFolder()
        if not bouldersFolder then return end
        
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local closest = nil
        local minDist = math.huge
        for _, b in ipairs(bouldersFolder:GetChildren()) do
            if string.find(string.lower(b.Name), string.lower(name)) then
                local part = getTargetPart(b)
                if part then
                    local dist = (root.Position - part.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = part
                    end
                end
            end
        end
        
        if closest then
            if activeTPBtn then
                activeTPBtn.Text = "TP & Hit"
                activeTPBtn.TextColor3 = THEME.AccentBlue
            end
            activeTPBtn = tpBtn
            activeTPBtn.Text = "STOP"
            activeTPBtn.TextColor3 = THEME.AccentRed
            teleportTo(closest, "SingleBoulder")
        else
            notify("Could not find any (" .. name .. ") on the map!", 4)
        end
    end)
end

