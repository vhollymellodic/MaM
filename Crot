local function getCapacityInfo()
    local PlayerData = player:FindFirstChild("PlayerData")
    if not PlayerData then return 0, 0 end
    
    local RealStats = PlayerData:FindFirstChild("RealStats")
    local maxWeight = 0
    if RealStats and RealStats:FindFirstChild("CarryWeight") then
        maxWeight = tonumber(RealStats.CarryWeight.Value) or 0
    end
    
    local currentWeight = 0
    local Inventory = PlayerData:FindFirstChild("Inventory")
    if Inventory and Inventory:FindFirstChild("Crystals") then
        for _, c in ipairs(Inventory.Crystals:GetChildren()) do
            local w = c:GetAttribute("WeightKg")
            if w then currentWeight = currentWeight + tonumber(w) end
        end
    end
    return maxWeight, currentWeight
end

local lastSellCheckTime = 0
local cachedSellCheckResult = false
local function isInventoryFull()
    if os.clock() - lastSellCheckTime > 1 then
        local maxW, currW = getCapacityInfo()
        if maxW > 0 then
            local threshold = maxW * 0.85 
            cachedSellCheckResult = (currW >= threshold)
