local function applyProfileToState(profileData)
    if not profileData then return end
    if profileData.minCrystalValueThreshold ~= nil then minCrystalValueThreshold = profileData.minCrystalValueThreshold end
    if profileData.currentCrystalMode ~= nil then currentCrystalMode = profileData.currentCrystalMode end
    if profileData.topX ~= nil then topX = profileData.topX end
    if profileData.isAutoCollectEnabled ~= nil then isAutoCollectEnabled = profileData.isAutoCollectEnabled end
    if profileData.promptsDisabled ~= nil then promptsDisabled = profileData.promptsDisabled end
    if profileData.boulderToggles ~= nil then 
        for k, v in pairs(profileData.boulderToggles) do
            boulderToggles[k] = v
        end
    end
end

local function SaveConfig()
    if not writefile then return end
    profiles[currentProfile] = {
        minCrystalValueThreshold = minCrystalValueThreshold,
        currentCrystalMode = currentCrystalMode,
        topX = topX,
        isAutoCollectEnabled = isAutoCollectEnabled,
        promptsDisabled = promptsDisabled,
        boulderToggles = boulderToggles
    }
    
    local data = {
        profiles = profiles,
        currentProfile = currentProfile,
        isFullAutoFarmEnabled = isFullAutoFarmEnabled,
        primaryResumeState = primaryResumeState
    }
    pcall(function()
        writefile(configFileName, HttpService:JSONEncode(data))
    end)
end

local function LoadConfig()
    if readfile and isfile then
        pcall(function()
            if isfile(configFileName) then
                local content = readfile(configFileName)
                local data = HttpService:JSONDecode(content)
                if data then
                    if data.profiles then profiles = data.profiles end
                    if data.currentProfile and profiles[data.currentProfile] then currentProfile = data.currentProfile end
                    if data.isFullAutoFarmEnabled ~= nil then isFullAutoFarmEnabled = data.isFullAutoFarmEnabled end
                    if data.primaryResumeState ~= nil then primaryResumeState = data.primaryResumeState end
                    
                    if not profiles["default"] then profiles["default"] = {} end
                    applyProfileToState(profiles[currentProfile])
                end
            end
        end)
    end
end

