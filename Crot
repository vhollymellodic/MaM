task.spawn(function()
    notify("Fase 2: Memulai Auto Scan Map untuk memaksa Game me-render chunk fisik...", 5)
    if ScanMapButton then ScanMapButton.Text = "AUTO SCANNING..." end
    
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    
    if rootPart and hum then
        isScanningMap = true
        rootPart.Anchored = true
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
        local safeGroundPos = Vector3.new(-241, 150, 157)
        rootPart.CFrame = CFrame.new(safeGroundPos)
        task.wait(1.5)
        
        local visitedBoulders = {}
        local bFolder = getBouldersFolder()
        if bFolder then
            for _, b in ipairs(bFolder:GetChildren()) do
                if not visitedBoulders[b] then
                    visitedBoulders[b] = true
                    local part = getTargetPart(b)
                    if part then
                        rootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 5, 0))
                        task.wait(0.05) 
                    end
                end
            end
        end
        
        rootPart.CFrame = CFrame.new(-41, 29, 1067)
        rootPart.Anchored = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        isScanningMap = false
    end
    
    if ScanMapButton then ScanMapButton.Text = "Scan Map" end
    
    notify("Fase 3: Auto Scan Selesai. Menyalakan Background Scanners secara aman...", 5)
    
    _G.BackgroundLoop_Active = true
    task.spawn(function()
        while _G.BackgroundLoop_Active do
            if promptsDisabled then
                for inst, data in pairs(crystalCache) do
                    if data.Prompt and data.Prompt.HoldDuration > 0 then
                        data.Prompt.HoldDuration = 0
                    end
                end
            end
            
            pcall(autoCollectSemua) 
            pcall(function()
                local lava = workspace:FindFirstChild("LavaHazards")
                if lava then lava:ClearAllChildren() end
            end)
            
            task.wait(0.25)
        end
    end)

    heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        lastUpdate = lastUpdate + deltaTime
        if lastUpdate >= updateInterval then
            lastUpdate = 0
            pcall(updateUI)
        end
    end)
    _G.CrystalHB_Loop = heartbeatConnection
    
    if isFullAutoFarmEnabled and primaryResumeState ~= "none" then
        notify("Fase 4: Meresume operasi niat awal pasca-hop: " .. primaryResumeState, 5)
        task.wait(1) 
        if primaryResumeState == "AutoBoulder" then
            if triggerBoulderFarm then triggerBoulderFarm() end
        elseif primaryResumeState == "AutoCrystal" then
            if triggerCrystalFarm then triggerCrystalFarm() end
        end
    end
end)
