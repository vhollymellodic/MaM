local function autoCollectSemua()
    if not isAutoCollectEnabled then return end
    
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local maxW, currW = getCapacityInfo()
    local remCap = maxW - currW
    if maxW <= 0 then remCap = math.huge end
    
    local rootPos = root.Position

    for inst, data in pairs(crystalCache) do
        if inst and inst.Parent and data.Prompt and data.Prompt.Enabled then
            local cPos = getCPosLocal(inst)
            if cPos and (cPos - rootPos).Magnitude <= 30 then
                local shouldCollect = true
                
                -- JANGAN MENYARING RUNE DENGAN FILTER HARGA CRYSTAL
                if not data.IsRune and currentCrystalMode <= 2 and data.Value < minCrystalValueThreshold then
                    shouldCollect = false
                end
                
                if shouldCollect and data.Weight <= remCap then
                    forceFirePrompt(data.Prompt) 
                    remCap = remCap - data.Weight 
                end
            end
        end
    end
end

