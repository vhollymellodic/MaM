local function updateUI()
    if isMinimized then return end 
    
    if isAutoFarming or isCrystalFarming or activeTopTarget ~= nil or isScanningMap then
        return 
    end
    
    local valueList, weightList = scanCrystals()
    local function formatTextAndCache(title, list, key, formatPrefix, formatSuffix)
        local text = "【 BEST " .. string.upper(title) .. " 】\n"
        local targetInstance = nil
        if #list == 0 then
            if currentCrystalCount == 0 then return text .. "⚠ Folders Empty (0 Objects)", nil
            else return text .. "⚠ No Prompts Found ("..currentCrystalCount..")", nil end
        end
        for i = 1, math.min(topX, #list) do
            local rawVal = list[i][key]
            local displayVal = ""
            if key == "Value" then
                displayVal = formatPrefix .. formatAbbreviation(rawVal) .. formatSuffix
            else
                displayVal = formatPrefix .. tostring(rawVal) .. formatSuffix
            end
            text = text .. " ▸ #" .. i .. " : " .. displayVal .. "\n"
            if i == topX then targetInstance = list[i].Instance end
        end
        return text, targetInstance
    end
    local vText, vInst = formatTextAndCache("Value", valueList, "Value", "$", "")
    local wText, wInst = formatTextAndCache("Weight", weightList, "Weight", "", " kg")
    
    ValueBtn.Text = vText
    WeightBtn.Text = wText

    currentTopInstances.Value = vInst
    currentTopInstances.Weight = wInst
    
    local bouldersFolder = getBouldersFolder()
    local boulderCounts = {}
    for _, pName in ipairs(autoFarmPriorityOrder) do boulderCounts[pName] = 0 end
    
    if bouldersFolder then
        for _, b in ipairs(bouldersFolder:GetChildren()) do
            for _, pName in ipairs(autoFarmPriorityOrder) do
                if string.find(string.lower(b.Name), string.lower(pName)) then
                    local hp = getTargetHP(b)
                    if hp == nil or hp > 0 then
                        boulderCounts[pName] = boulderCounts[pName] + 1
                    end
                end
            end
        end
    end

    for name, tpBtn in pairs(boulderTPButtons) do
        local count = boulderCounts[name] or 0
        if boulderRowLabels[name] then boulderRowLabels[name].Text = name .. " (" .. count .. ")" end
        
        if count > 0 then
            if activeTPBtn ~= tpBtn then
                tpBtn.Text = "TP & Hit"
                tpBtn.TextColor3 = THEME.AccentBlue
            end
            tpBtn.Active = true
            tpBtn.AutoButtonColor = true
        else
            tpBtn.Text = "Not Exist"
            tpBtn.TextColor3 = THEME.AccentRed
            tpBtn.Active = false
            tpBtn.AutoButtonColor = false
        end
    end

    for name, toggleBtn in pairs(boulderToggleBtns) do
        if boulderCounts[name] > 0 then
            toggleBtn.Active = true
            toggleBtn.AutoButtonColor = true
            if boulderToggles[name] then
                toggleBtn.Text = name .. " Auto: ON"
                toggleBtn.TextColor3 = Color3.fromRGB(50, 220, 100)
            else
                toggleBtn.Text = name .. " Auto: OFF"
                toggleBtn.TextColor3 = Color3.fromRGB(130, 130, 140)
            end
        else
            toggleBtn.Text = name .. " - Not Exist"
            toggleBtn.TextColor3 = THEME.AccentRed
            toggleBtn.Active = false
            toggleBtn.AutoButtonColor = false
        end
    end
end

