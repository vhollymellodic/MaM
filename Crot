ScanMapButton.MouseButton1Click:Connect(function()
    if isScanningMap then return end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    isScanningMap = true
    ScanMapButton.Text = "Scanning Map..."
    ScanMapButton.TextColor3 = THEME.TextWhite
    
    task.spawn(function()
        rootPart.Anchored = true
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char, camera}
        
        local highPoint = Vector3.new(-241, 648, 157)
        local groundHit = workspace:Raycast(highPoint, Vector3.new(0, -1000, 0), rayParams)
        local safeGroundPos = groundHit and (groundHit.Position + Vector3.new(0, 5, 0)) or Vector3.new(-241, 150, 157)
        
        rootPart.CFrame = CFrame.new(safeGroundPos)
        task.wait(1.5)
        
        local bouldersFolder = getBouldersFolder()
        if bouldersFolder then
            for _, b in ipairs(bouldersFolder:GetChildren()) do
                local part = getTargetPart(b)
                if part then
                    rootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 5, 0))
                    task.wait(0.05)
                end
            end
        end
        
        rootPart.CFrame = CFrame.new(-41, 29, 1067)
        rootPart.Anchored = false
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        
        ScanMapButton.Text = "Scan Map"
        ScanMapButton.TextColor3 = THEME.AccentOrange
        isScanningMap = false
        pcall(updateUI) 
    end)
end)

