local crystalCache = {} 
local currentCrystalCount = 0

local function cacheItem(item)
    task.delay(0.5, function()
        if not item or not item.Parent then return end
        local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            local wStr = prompt.ObjectText and string.match(prompt.ObjectText, "([%d%.,]+)%s*kg")
            local vStr = prompt.ObjectText and string.match(prompt.ObjectText, "%$([%d%.,a-zA-Z]+)")
            local weight = tonumber((string.gsub(wStr or "0", ",", ""))) or 0
            local val = parseValue(vStr)
            
            -- FIX LAGGING RUNE: Menandai apakah item ini adalah Rune atau bukan
            local isRune = (item.Parent.Name == "DroppedRunes")
            
            crystalCache[item] = { 
                Instance = item, 
                Value = val, 
                Weight = weight, 
                Prompt = prompt,
                IsRune = isRune
            }
        end
    end)
end

local function initCacheFolder(folder)
    if not folder then return end
    for _, item in ipairs(folder:GetChildren()) do
        cacheItem(item)
    end
    folder.ChildAdded:Connect(cacheItem)
    folder.ChildRemoved:Connect(function(item)
        crystalCache[item] = nil
    end)
end

