-- ====================================================================
-- TELEPORT & COLLECT CRYSTAL (MACHINE GUN MODE)
-- ====================================================================
teleportAndCollect = function(crystalInstance, targetType)
    if not crystalInstance then return end
    
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChild("Humanoid")
    if not rootPart or not humanoid then return end

    stopAutoMine(true)
    activeTopTarget = targetType

    local targetPos = getCPosLocal(crystalInstance)
    if not targetPos then 
        activeTopTarget = nil
        return 
    end

    local hoverOffset = Vector3.new(2.5, 0, 2.5)
    rootPart.CFrame = CFrame.lookAt(targetPos + hoverOffset, targetPos)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyBV"
    bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = rootPart

    local bg = Instance.new("BodyGyro")
    bg.Name = "FlyBG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 10000
    bg.Parent = rootPart
    
    local platform = workspace:FindFirstChild("CrystalPlatform")
    if not platform then
        platform = Instance.new("Part")
        platform.Name = "CrystalPlatform"
        platform.Size = Vector3.new(10, 1, 10)
        platform.Anchored = true
        platform.Transparency = 1
        platform.CanCollide = true
        platform.Parent = workspace
    end
    platform.CFrame = CFrame.new(targetPos.X + 2.5, targetPos.Y - 3.5, targetPos.Z + 2.5)

    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

    local phase = "Collecting"
    local lootTimer = 0
    local hasFiredSell = false
    local lastHP = math.huge
    local lastHPChangeTime = os.clock()
    isMiningThreadActive = true

    task.spawn(function()
        while isMiningThreadActive and activeTopTarget == targetType do
            if phase == "Collecting" then
                local currentHP = getTargetHP(crystalInstance)
                if currentHP ~= nil and currentHP < 1 then break end
                if not crystalInstance or not crystalInstance.Parent then break end

                if currentHP ~= nil then
                    if currentHP ~= lastHP then
                        lastHP = currentHP
                        lastHPChangeTime = os.clock()
                    end
                else
                    lastHPChangeTime = os.clock()
                end

                if os.clock() - lastHPChangeTime > 60 then break end

                local prompt = crystalCache[crystalInstance] and crystalCache[crystalInstance].Prompt
                if not prompt then
                    prompt = crystalInstance:FindFirstChildWhichIsA("ProximityPrompt", true)
                end
                if prompt then forceFirePrompt(prompt) end
            end
            task.wait(0.05) 
        end
    end)

    autoWalkConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not humanoid or humanoid.Health <= 0 then
            stopAutoMine(false)
            return
        end

        local cPos = getCPosLocal(crystalInstance)
        local isDead = false
        if not cPos then isDead = true end
        
        local currentHP = getTargetHP(crystalInstance)
        if currentHP ~= nil and currentHP < 1 then isDead = true end
        if not crystalInstance or not crystalInstance.Parent then isDead = true end
        
        if currentHP ~= nil and (os.clock() - lastHPChangeTime > 60) then
            isDead = true
            if crystalInstance and crystalInstance.Parent then failedCrystals[crystalInstance] = true end
        end

        if phase ~= "Selling" and phase ~= "PreSell" and isInventoryFull() then
            phase = "PreSell"
            lootTimer = 1.5 
            return
        end

        if phase == "Collecting" then
            if isDead then
                phase = "Done"
                lootTimer = 1.0 
                bv.Velocity = Vector3.zero
                return
            end

            local dynamicHover = cPos + hoverOffset
            rootPart.CFrame = CFrame.lookAt(dynamicHover, cPos)
            bv.Velocity = Vector3.zero
            bg.CFrame = CFrame.lookAt(dynamicHover, cPos)
            
            local plat = workspace:FindFirstChild("CrystalPlatform")
            if plat then plat.CFrame = CFrame.new(cPos.X + 2.5, cPos.Y - 3.5, cPos.Z + 2.5) end
            
        elseif phase == "Done" then
            bv.Velocity = Vector3.zero
            lootTimer = lootTimer - deltaTime
            
            if lootTimer <= 0 then
                if targetType == "AutoCrystal" and isCrystalFarming then
                    local nextTarget = getNextCrystalTarget()
                    if nextTarget then 
                        teleportAndCollect(nextTarget, "AutoCrystal")
                    else
                        failedCrystals = {} 
                        task.wait(0.5)
                        nextTarget = getNextCrystalTarget()
                        if nextTarget then 
                            teleportAndCollect(nextTarget, "AutoCrystal")
                        else 
                            notify("Semua Crystal selesai/Bersih/Terfilter!", 3)
                            if isFullAutoFarmEnabled then
                                serverHop() 
                            else
                                notify("Full Auto Farm OFF. Berhenti.", 3)
                                stopAutoMine(false)
                            end
                        end
                    end
                else
                    stopAutoMine(false)
                end
            end
            
        elseif phase == "PreSell" then
            bv.Velocity = Vector3.zero
            lootTimer = lootTimer - deltaTime
            if lootTimer <= 0 then
                phase = "Selling"
                lootTimer = 3.5 
                hasFiredSell = false
                if bv then bv.Velocity = Vector3.zero; bv.MaxForce = Vector3.zero end
                if bg then bg.MaxTorque = Vector3.zero end
            end
            
        elseif phase == "Selling" then
            bv.Velocity = Vector3.zero
            lootTimer = lootTimer - deltaTime
            rootPart.CFrame = CFrame.new(-41, 29, 1067) 
            
            if lootTimer <= 0.5 and not hasFiredSell then
                hasFiredSell = true
                pcall(function() SellRequest:FireServer("all") end)
            end
            
            if lootTimer <= 0 then
                if targetType == "AutoCrystal" and isCrystalFarming then
                    failedCrystals = {}
                    if crystalInstance and crystalInstance.Parent then
                        teleportAndCollect(crystalInstance, "AutoCrystal")
                    else
                        local nextTarget = getNextCrystalTarget()
                        if nextTarget then 
                            teleportAndCollect(nextTarget, "AutoCrystal")
                        else 
                            notify("Map bersih dari Crystal/Terfilter!", 3)
                            if isFullAutoFarmEnabled then
                                serverHop() 
                            else
                                notify("Full Auto Farm OFF. Berhenti.", 3)
                                stopAutoMine(false)
                            end
                        end
                    end
                else
                    stopAutoMine(false)
                end
            end
        end
    end)
end

-- ====================================================================
-- TELEPORT TO BOULDERS (FIX RANGE, DYNAMIC TARGET & ANIMATION)
-- ====================================================================
teleportTo = function(targetInstance, mode)
    if not targetInstance then return end
    
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChild("Humanoid")
    if not rootPart or not humanoid then return end

    stopAutoMine(true)
    activeTopTarget = mode

    -- FIX 1: Jarak didekatkan jadi 4.5 stud agar masuk Hitbox Melee Tool
    local hoverDistance = 4.5 
    
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = rootPart

    local bg = Instance.new("BodyGyro")
    bg.Name = "FlyBG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 10000
    bg.Parent = rootPart

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    
    local phase = "Mining"
    local lootTimer = 0
    local hasFiredSell = false
    local lastHP = math.huge
    local lastHPChangeTime = os.clock()
    isMiningThreadActive = true
    
    -- FIX 2: Fungsi pencari target Dinamis (mencegah mukul udara kosong)
    local function getDynamicPos()
        if not targetInstance or not targetInstance.Parent then return nil end
        if targetInstance:IsA("Model") and targetInstance.PrimaryPart then 
            return targetInstance.PrimaryPart.Position
        elseif targetInstance:IsA("BasePart") then 
            return targetInstance.Position
        else
            local p = targetInstance:FindFirstChildWhichIsA("BasePart", true)
            return p and p.Position or nil
        end
    end

    local initialPos = getDynamicPos()
    if not initialPos then return end
    
    task.spawn(function()
        while isMiningThreadActive do
            if phase == "Mining" then
                local equippedTool = character:FindFirstChildOfClass("Tool")
                if not equippedTool then
                    local toolInBackpack = player:WaitForChild("Backpack"):FindFirstChildOfClass("Tool")
                    if toolInBackpack then
                        humanoid:EquipTool(toolInBackpack)
                        equippedTool = toolInBackpack
                        task.wait(0.2) 
                    end
                end

                local currentPos = getDynamicPos()
                if equippedTool and currentPos and rootPart then
                    -- FIX 3: Memicu Animasi Pukulan Original dari Game
                    pcall(function() equippedTool:Activate() end)
                    -- Menembakkan damage ke koordinat batu yang sesungguhnya
                    pcall(function() DigRequest:FireServer(equippedTool.Name, currentPos) end)
                end
            end
            task.wait(0.2) 
        end
    end)

    autoWalkConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not humanoid or humanoid.Health <= 0 then
            stopAutoMine(false)
            return
        end

        local isDead = false
        local currentHP = getTargetHP(targetInstance)
        if currentHP ~= nil and currentHP < 1 then isDead = true end
        if not targetInstance or not targetInstance.Parent then isDead = true end

        if phase ~= "Selling" and phase ~= "PreSell" and isInventoryFull() then
            phase = "PreSell"
            lootTimer = 1.5
            return
        end

        if phase == "Mining" then
            if isDead then
                phase = "Looting"
                lootTimer = 1.5 
                bv.Velocity = Vector3.zero
                return
            end

            -- FIX 4: Update posisi terbang terus-menerus mengikuti sisa batu
            local currentPos = getDynamicPos() or initialPos
            local dynamicHover = currentPos + Vector3.new(0, hoverDistance, 0)
            
            rootPart.CFrame = CFrame.lookAt(dynamicHover, currentPos)
            bv.Velocity = Vector3.zero
            bg.CFrame = CFrame.lookAt(dynamicHover, currentPos)
            
        elseif phase == "Looting" then
            bv.Velocity = Vector3.zero
            lootTimer = lootTimer - deltaTime
            
            if lootTimer <= 0 then
                if mode == "AutoBoulder" and isAutoFarming then
                    local nextTarget = getNextAutoFarmTarget()
                    if nextTarget then 
                        teleportTo(nextTarget, "AutoBoulder")
                    else 
                        fallbackToCrystalFarm()
                    end
                else
                    stopAutoMine(false) 
                end
            end

        elseif phase == "PreSell" then
            bv.Velocity = Vector3.zero
            lootTimer = lootTimer - deltaTime
            if lootTimer <= 0 then
                phase = "Selling"
                lootTimer = 3.5
                hasFiredSell = false
                if bv then bv.Velocity = Vector3.zero; bv.MaxForce = Vector3.zero end
                if bg then bg.MaxTorque = Vector3.zero end
            end
            
        elseif phase == "Selling" then
            bv.Velocity = Vector3.zero
            lootTimer = lootTimer - deltaTime
            rootPart.CFrame = CFrame.new(-41, 29, 1067)
            
            if lootTimer <= 0.5 and not hasFiredSell then
                hasFiredSell = true
                pcall(function() SellRequest:FireServer("all") end)
            end
            
            if lootTimer <= 0 then
                if mode == "AutoBoulder" and isAutoFarming then
                    local nextTarget = getNextAutoFarmTarget()
                    if nextTarget then 
                        teleportTo(nextTarget, "AutoBoulder")
                    else 
                        fallbackToCrystalFarm()
                    end
                else
                    stopAutoMine(false)
                end
            end
        end
    end)
end


