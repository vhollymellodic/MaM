        end
        lastSellCheckTime = os.clock()
    end
    return cachedSellCheckResult
end

local function parseValue(str)
    if type(str) ~= "string" or str == "" then return 0 end
    str = string.gsub(str, ",", "")
    local numStr, suffix = string.match(string.upper(str), "([%d%.]+)%s*([A-Z]*)")
    local num = tonumber(numStr) or 0
    if suffix == "K" then num = num * 1e3
    elseif suffix == "M" then num = num * 1e6
    elseif suffix == "B" then num = num * 1e9
    elseif suffix == "T" then num = num * 1e12
    elseif suffix == "QA" then num = num * 1e15
    elseif suffix == "QI" then num = num * 1e18
    elseif suffix == "SX" then num = num * 1e21 end
    return num
end

local function formatAbbreviation(num)
    if num >= 1e21 then return string.format("%.2fSx", num / 1e21):gsub("%.00", "")
    elseif num >= 1e18 then return string.format("%.2fQi", num / 1e18):gsub("%.00", "")
    elseif num >= 1e15 then return string.format("%.2fQa", num / 1e15):gsub("%.00", "")
    elseif num >= 1e12 then return string.format("%.2fT", num / 1e12):gsub("%.00", "")
    elseif num >= 1e9 then return string.format("%.2fB", num / 1e9):gsub("%.00", "")
    elseif num >= 1e6 then return string.format("%.2fM", num / 1e6):gsub("%.00", "")
    elseif num >= 1e3 then return string.format("%.2fK", num / 1e3):gsub("%.00", "")
    else return tostring(num) end
end

